{
    "name": "dice-rpg",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite --port 5175",
        "dev:full": "convex dev --start 'vite --host 0.0.0.0 --port 5175'",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "convex": "convex dev",
        "lint": "biome lint .",
        "lint:fix": "biome lint --write .",
        "format": "biome format --write .",
        "format:check": "biome format .",
        "proofs:check": "node scripts/lean/check-generated.mjs",
        "proofs:generate": "node scripts/lean/check-generated.mjs --write",
        "docs:lean": "node scripts/lean/build-definition-reader.mjs",
        "docs:lean:check": "node scripts/lean/build-definition-reader.mjs --check",
        "check:architecture": "node scripts/quality/check-architecture.mjs",
        "check": "npm run check:architecture && npm run proofs:check && npm run docs:lean:check && npm run test:quality && npm run test:convex && npm run lint && npm run format:check && npm run build",
        "test:convex": "vitest run",
        "test:quality": "node --test scripts/quality/*.test.mjs",
        "setup:hooks": "node scripts/quality/install-git-hooks.mjs"
    },
    "dependencies": {
        "@react-three/drei": "^10.7.8",
        "@react-three/fiber": "^9.7.0",
        "@teamhanko/hanko-elements": "^3.0.0",
        "convex": "^1.45.0",
        "qrcode.react": "^4.2.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "three": "^0.185.1"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.12",
        "@edge-runtime/vm": "^5.0.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.7",
        "@types/three": "^0.185.4",
        "@vitejs/plugin-react": "^6.1.1",
        "convex-test": "^0.0.56",
        "typescript": "^7.0.2",
        "vite": "^8.2.2",
        "vitest": "^4.1.11"
    }
}
