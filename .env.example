# Vercel production and preview builds.
CONVEX_DEPLOY_KEY=
VITE_HANKO_API_URL=

# `npx convex dev` writes CONVEX_DEPLOYMENT and VITE_CONVEX_URL to
# `.env.local`. VITE_CONVEX_SITE_URL is not used by this application.

# Set on the Convex deployment, not in Vite.
# HANKO_API_URL=
# HANKO_JWT_ISSUER=
# HANKO_JWT_AUDIENCE=
# DEV_NO_AUTH must remain unset in preview and production.
